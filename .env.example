# ── Supabase (projet dédié Whoop Tracker) ──────────────────────────────
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_ici

# ── Whoop API v2 (OAuth 2.0) ───────────────────────────────────────────
# Whoop Developer Dashboard > ton App
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# URL de callback OAuth (doit matcher celle déclarée dans l'app Whoop)
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback
# Refresh token obtenu après le 1er consentement OAuth (scope offline)
WHOOP_REFRESH_TOKEN=

# Secret simple pour protéger l'endpoint de pull déclenché par le cron Render
CRON_SECRET=
